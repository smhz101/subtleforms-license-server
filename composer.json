{
	"name": "subtleforms/license-server",
	"description": "Development tooling for the SubtleForms License Server plugin (not shipped).",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"digitalrevolution/php-codesniffer-baseline": "^1.1",
		"php-stubs/woocommerce-stubs": "^10.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.12",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"digitalrevolution/php-codesniffer-baseline": true
		}
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml",
		"lint:phpcs": "phpcs",
		"lint:phpstan": "phpstan analyse --memory-limit=2G --no-progress"
	}
}
