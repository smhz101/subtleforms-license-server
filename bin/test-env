#!/usr/bin/env bash
# Run the PHPUnit integration suite.
#
# Env vars:
#   SFLS_WP_PATH   Existing WordPress (with WooCommerce + this plugin active). If set, it is used as is.
#   WC_VERSION     WooCommerce version for a throwaway site (default 10.2.1, the CI pin).
#   DB_HOST/DB_USER/DB_PASS/DB_NAME  MySQL for the throwaway site (default 127.0.0.1/root/root/sfls_test).
#                  The database is dropped and recreated.
#   WP_DIR         Where to build the throwaway site (default: a new temp dir).
#   PHPUNIT        phpunit binary (default vendor/bin/phpunit, else phpunit on PATH).
# Extra arguments go to phpunit, e.g. bin/test-env --filter ReleaseApi
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
phpunit="${PHPUNIT:-}"
if [ -z "$phpunit" ]; then
	if [ -x "$root/vendor/bin/phpunit" ]; then phpunit="$root/vendor/bin/phpunit"; else phpunit=phpunit; fi
fi

if [ -z "${SFLS_WP_PATH:-}" ]; then
	# Mirrors the "phpunit" job in .github/workflows/checks.yml.
	WC_VERSION="${WC_VERSION:-10.2.1}"
	DB_HOST="${DB_HOST:-127.0.0.1}"; DB_USER="${DB_USER:-root}"; DB_PASS="${DB_PASS:-root}"; DB_NAME="${DB_NAME:-sfls_test}"
	WP_DIR="${WP_DIR:-$(mktemp -d)/wordpress}"
	wp() { command wp --path="$WP_DIR" "$@"; }
	mkdir -p "$WP_DIR"
	command wp core download --path="$WP_DIR" --force
	wp config create --dbname="$DB_NAME" --dbuser="$DB_USER" --dbpass="$DB_PASS" --dbhost="$DB_HOST" --skip-check --force
	wp db reset --yes
	wp config set WP_DEBUG true --raw
	wp config set WP_DEBUG_LOG true --raw
	wp config set WP_DEBUG_DISPLAY false --raw
	wp config set WP_ENVIRONMENT_TYPE local
	wp config set DISABLE_WP_CRON true --raw
	wp config set AUTOMATIC_UPDATER_DISABLED true --raw
	wp core install --url=http://localhost:8899 --title="SFLS tests" --admin_user=admin \
		--admin_password=password --admin_email=admin@example.test --skip-email
	wp plugin install woocommerce --version="$WC_VERSION" --activate
	ln -sfn "$root" "$WP_DIR/wp-content/plugins/subtleforms-license-server"
	wp plugin activate subtleforms-license-server
	wp wc hpos enable
	wp rewrite structure '/%postname%/'
	wp option update woocommerce_cheque_settings '{"enabled":"yes","title":"Check payments"}' --format=json
	# The same seed as CI (plans pricing, one license, one published release).
	wp eval-file "$root/tests/bin/seed-site.php"
	wp config set WP_HTTP_BLOCK_EXTERNAL true --raw
	export SFLS_WP_PATH="$WP_DIR"
	echo "Throwaway WordPress at $WP_DIR"
fi

export SFLS_WP_CLI="${SFLS_WP_CLI:-$(command -v wp || true)}"
cd "$root"
exec "$phpunit" -c phpunit.xml "$@"
