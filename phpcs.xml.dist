<?xml version="1.0"?>
<ruleset name="SubtleForms License Server">
	<description>WordPress coding standards. Existing findings live in phpcs.baseline.xml; only new ones fail.</description>

	<file>includes</file>
	<file>templates</file>
	<file>subtleforms-license-server.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="subtleforms-license-server"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="SFLS"/>
				<element value="sfls"/>
			</property>
		</properties>
	</rule>
</ruleset>
